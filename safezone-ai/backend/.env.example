# SafeZone AI Backend Configuration
# Copy this file to .env and fill in real values

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database
DATABASE_URL=sqlite+aiosqlite:///./safezone.db

# MQTT Broker (do NOT commit real credentials)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_INCIDENTS=safezone/incidents
MQTT_TOPIC_STATUS=safezone/status
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=safezone-backend

# Perception / PipeGen
PERCEPTION_ADAPTER=simulated
PIPEGEN_OUTPUT_DIR=./pipegen_output
DETECTION_CONFIDENCE_THRESHOLD=0.5
INCIDENT_COOLDOWN_SECONDS=5

# Logging
LOG_LEVEL=INFO
